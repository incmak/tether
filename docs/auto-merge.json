{
  "version": 1,
  "areas": [
    {
      "name": "tests",
      "label": "Tests",
      "paths": [
        "server/test_*.py",
        "server/tests/**",
        "server/fixtures/**",
        "server/test_fixtures/**",
        "scripts/test_*.py",
