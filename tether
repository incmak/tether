#!/usr/bin/env python3
"""Apply tagged Tether releases with a health check and automatic rollback; message many agent panes (broadcast);
change work board items (item: run `tether item --help`), and connect Jira (jira: run `tether jira --help`)."""
import argparse
import contextlib
import fcntl
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import threading
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

sys.path.insert(0, str(Path(__file__).resolve().parent / 'server'))
import updates

DARWIN = sys.platform == 'darwin'
TERMUX = not DARWIN and (bool(os.environ.get('TERMUX_VERSION')) or os.environ.get('PREFIX', '').startswith('/data/data/com.termux/'))


_spec = importlib.util.spec_from_file_location(
    'tether_bootstrap', Path(__file__).resolve().parent / 'integrations/claude/tether/skills/setup/bootstrap.py')
bootstrap = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(bootstrap)
switch, extract, download = bootstrap.switch, bootstrap.extract, bootstrap.download
release_files = bootstrap.release_files


def run(command, quiet=False):
    if not quiet:
        subprocess.run(command, check=True, timeout=600)
        return
    # Hide the long plan on success; show it when the command fails. Warnings stay on stderr.
    result = subprocess.run(command, stdout=subprocess.PIPE, text=True, timeout=600)
    if result.returncode:
        sys.stdout.write(result.stdout)
        raise subprocess.CalledProcessError(result.returncode, command)


def launchd_label(name):
    suffix = 'chat' if name == 'tether.service' else name.removeprefix('tether-').removesuffix('.service')
    return 'local.tether.' + suffix


def runit_name(name):
    return name.removesuffix('.service')


def restart(state):
    units = [unit for unit in state.get('unit_names', ['tether.service'])
             if unit in ('tether.service', 'tether-terminal.service', 'tether-voice.service')]
    if 'tether.service' not in units:
        units.insert(0, 'tether.service')
    if TERMUX:
        folder = Path(os.environ.get('PREFIX', '/data/data/com.termux/files/usr')) / 'var/service'
        for unit in units:
            run(['sv', 'restart', str(folder / runit_name(unit))])
        return
    if DARWIN:
        # launchd sets XPC_SERVICE_NAME to the job label. A bootout of the update job from inside that job would
        # stop this update before it finishes, so the running update job keeps its loaded plist until next login.
        if ('tether-update.service' in state.get('unit_names', []) and
                os.environ.get('XPC_SERVICE_NAME') != launchd_label('tether-update.service')):
            units.append('tether-update.service')
        domain = f'gui/{os.getuid()}'
        for unit in units:
            label = launchd_label(unit)
            try:
                run(['launchctl', 'bootout', f'{domain}/{label}'], quiet=True)
            except (OSError, subprocess.SubprocessError):
                pass
            run(['launchctl', 'bootstrap', domain, str(Path.home() / 'Library/LaunchAgents' / (label + '.plist'))])
        return
    run(['systemctl', '--user', 'daemon-reload'])
    run(['systemctl', '--user', 'restart', *units])
    if 'tether-update.timer' in state.get('unit_names', []):
        run(['systemctl', '--user', 'enable', '--now', 'tether-update.timer'])
        run(['systemctl', '--user', 'restart', 'tether-update.timer'])


def healthy(port, seconds=30, host='127.0.0.1'):
    host = '127.0.0.1' if host in ('0.0.0.0', 'localhost', '::') else host
    if ':' in host:
        host = f'[{host}]'
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        try:
            with urlopen(f'http://{host}:{int(port)}/chat/', timeout=min(2, max(.1, end - time.monotonic()))) as response:
                if response.status == 200:
                    return True
        except (OSError, ValueError):
            pass
        time.sleep(min(1, max(0, end - time.monotonic())))
    return False


def git_checkout(repo):
    # A .git marker counts even when git refuses the folder (ownership, broken worktree).
    if (Path(repo) / '.git').exists():
        return True
    try:
        # Only a checkout rooted at this folder counts; a dotfiles repo in $HOME does not.
        result = subprocess.run(['git', '-C', str(repo), 'rev-parse', '--show-toplevel'],
                                capture_output=True, text=True, timeout=10)
        return result.returncode == 0 and Path(result.stdout.strip()).resolve() == Path(repo).resolve()
    except (OSError, subprocess.SubprocessError):
        return (Path(repo) / '.git').exists()


def snapshot(state_file):
    home = Path.home()
    if TERMUX:
        units = Path(os.environ.get('PREFIX', '/data/data/com.termux/files/usr')) / 'var/service'
        paths = [units / runit_name(name) / script for name in
                 ('tether.service', 'tether-terminal.service', 'tether-voice.service') for script in ('run', 'log/run')]
    elif DARWIN:
        units = home / 'Library/LaunchAgents'
        paths = [units / (launchd_label(name) + '.plist') for name in
                 ('tether.service', 'tether-terminal.service', 'tether-voice.service', 'tether-update.service')]
    else:
        units = home / '.config/systemd/user'
        paths = [units / name for name in ('tether.service', 'tether-terminal.service', 'tether-voice.service',
                                          'tether-update.service', 'tether-update.timer')]
    for folder in ('.claude', '.gemini/antigravity-cli'):
        settings = home / folder / 'settings.json'
        paths.extend([settings, settings.with_name('settings.json.before-tether')])
    paths.append(home / '.local/bin/tether')
    return state_file.read_bytes(), {
        path: ('link', str(path.readlink())) if path.is_symlink() else
        path.read_bytes() if path.exists() else None for path in paths}


def restore(state_file, backup):
    content, files = backup
    state_file.write_bytes(content)
    for path, data in files.items():
        if data is None:
            path.unlink(missing_ok=True)
        elif isinstance(data, tuple):
            path.unlink(missing_ok=True)
            path.symlink_to(data[1])
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
            if TERMUX and path.name == 'run':
                path.chmod(0o755)


def migrate(args, root, state_file, state):
    checkout = Path(args.source or state['repo']).expanduser().resolve()
    if checkout != Path(state['repo']).resolve() or not git_checkout(checkout):
        raise ValueError('Migration source must be the saved installation checkout')
    try:
        dirty = subprocess.run(['git', '-C', str(checkout), 'status', '--porcelain'],
                               capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        dirty = None
    if dirty is None or dirty.returncode or dirty.stdout.strip():
        print('Warning: checkout has local changes or git status is unavailable; checkout stays untouched.')
    backup = snapshot(state_file)
    link = root / 'current'
    if link.exists() and not link.is_symlink():
        raise ValueError('Refusing to replace a non-symlink current path')
    old_link = link.readlink() if link.is_symlink() else None
    target = bootstrap.stage(args, root, reuse=True)
    try:
        switch(link, target)
        run([sys.executable, str(link / 'install.py'), '--apply', '--json', '--no-build-ui', '--defer-restart'], quiet=True)
        new_state = json.loads(state_file.read_text())
        restart(new_state)
        if not healthy(new_state['options']['port'], host=new_state['options'].get('host', '127.0.0.1')):
            raise RuntimeError('Health check failed')
    except Exception as error:
        if old_link is None:
            link.unlink(missing_ok=True)
        else:
            switch(link, old_link)
        restore(state_file, backup)
        try:
            restart(state)
        except Exception as rollback_error:
            raise RuntimeError(f'{error}; restored checkout files, but restart failed: {rollback_error}') from error
        if old_link is None or link.resolve() != target.resolve():
            shutil.rmtree(target)
        raise RuntimeError(f'{error}; rolled back to checkout {checkout}') from error
    print(f'Migrated to v{target.name}. Checkout {checkout} is no longer used and can be removed by you.')
    return 0


def activate(root, target, state_file, state):
    link = root / 'current'
    old = link.resolve(strict=True)
    backup = snapshot(state_file)
    try:
        # Stage stable unit paths before changing the running release.
        run([sys.executable, str(target / 'install.py'), '--apply', '--no-build-ui',
             '--release-current', str(link), '--defer-restart'])
        switch(link, target)
        new_state = json.loads(state_file.read_text())
        restart(new_state)
        if not healthy(state['options']['port'], host=state['options'].get('host', '127.0.0.1')):
            raise RuntimeError('Health check failed')
    except Exception as error:
        switch(link, old)
        restore(state_file, backup)
        try:
            restart(state)
        except Exception as rollback_error:
            raise RuntimeError(f'{error}; restored prior release, but restart failed: {rollback_error}') from error
        raise RuntimeError(f'{error}; rolled back to {old.name}') from error
    (root / 'previous.json').write_text(json.dumps({'release': old.name}))
    # Retain the active release and its rollback target, regardless of version order.
    for entry in (root / 'releases').iterdir():
        if entry.is_dir() and not entry.is_symlink() and entry.resolve() not in (old, target.resolve()):
            try:
                updates.version(entry.name)
                if (entry / 'VERSION').read_text().strip() != entry.name or git_checkout(entry):
                    continue
            except (OSError, ValueError):
                continue
            shutil.rmtree(entry)


def server_port():
    if os.environ.get('MOBILE_TMUX_PORT'):
        return int(os.environ['MOBILE_TMUX_PORT'])
    try:
        return int(json.loads(updates.install_file().read_text())['options']['port'])
    except (OSError, ValueError, KeyError, TypeError):
        return 7683


LABELS = {'sent': 'sent', 'sent_busy': 'sent while busy', 'handed_off': 'handed to the master', 'skipped': 'skipped', 'failed': 'failed'}


def broadcast(args, opener=urlopen):
    """Ask the running Tether server to send one message to many panes, through its guarded broker
    (POST /mobile/api/broadcast). Panes that wait on an approval or a picker are skipped. This pane ($TMUX_PANE) is never a target."""
    import auth  # server/auth.py: the token file and the cookie the server expects
    port = server_port()
    body = {'message': args.text, 'via': 'claude' if args.master else 'direct', 'master': args.master,
            'exclude': os.environ.get('TMUX_PANE') or None}
    if args.panes:
        body['panes'] = [pane for item in args.panes for pane in item.replace(',', ' ').split()]
    headers = {'Content-Type': 'application/json', 'X-Codex-Mobile': '1', 'Origin': f'http://127.0.0.1:{port}'}
    try:
        secret = auth.TOKEN_FILE.read_text().strip()
    except OSError:
        secret = ''  # proxy mode needs no sign-in
    if secret:
        headers['Cookie'] = f'{auth.COOKIE}={auth.session_value(secret)}'
    request = Request(f'http://127.0.0.1:{port}/mobile/api/broadcast', data=json.dumps(body).encode(), headers=headers, method='POST')
    try:
        with opener(request, timeout=600) as response:
            data = json.loads(response.read())
    except HTTPError as error:
        try:
            message = json.loads(error.read()).get('error') or str(error)
        except ValueError:
            message = str(error)
        print(message, file=sys.stderr)
        return 1
    except URLError as error:
        print(f'Tether is not reachable on port {port}: {error.reason}', file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        rows = ([dict(data['master'], name='master: ' + data['master']['name'])] if data.get('master') else []) + data['results']
        for item in rows:
            reason = f" ({item['reason']})" if item.get('reason') else ''
            print(f"{item['pane']}\t{item['name']}\t{LABELS.get(item['result'], item['result'])}{reason}")
    return 2 if any(item.get('result') == 'failed' for item in data['results'] + [data.get('master') or {}]) else 0


def report_update(argv):
    """Keep the server's run identity and report even when the normal CLI raises."""
    target = next((arg.split('=', 1)[1] for arg in argv if arg.startswith('--to=')), updates.current_version())
    if '--to' in argv and argv.index('--to') + 1 < len(argv):
        target = argv[argv.index('--to') + 1]
    data = updates.read_run() or dict(target=target.removeprefix('v'), started_at=time.time())
    data = dict(data, state='failed', error='The update failed.')
    output = []
    result = 1
    saved_stderr = os.dup(2)
    original = sys.stderr
    try:
        forward = original if original.fileno() != 2 else os.fdopen(os.dup(saved_stderr), 'w')
    except (AttributeError, OSError, ValueError):
        forward = original
    reader, writer = os.pipe()

    def copy_stderr():
        with os.fdopen(reader, 'r', encoding='utf-8', errors='replace') as stream:
            for line in stream:
                output.append(line)
                forward.write(line)
                forward.flush()

    def terminated(signum, frame):
        raise SystemExit('The update was terminated (SIGTERM).')

    previous = signal.signal(signal.SIGTERM, terminated)
    worker = threading.Thread(target=copy_stderr, daemon=True)
    worker.start()
    try:
        with os.fdopen(writer, 'w', encoding='utf-8', errors='replace', buffering=1) as stream:
            original.flush()
            os.dup2(stream.fileno(), 2)  # Capture inherited subprocess stderr too.
            try:
                with contextlib.redirect_stderr(stream):
                    try:
                        result = main(argv)
                    except BaseException as error:
                        if not isinstance(error, SystemExit) or isinstance(error.code, str):
                            print(str(error) or type(error).__name__, file=sys.stderr)
                        raise
            finally:
                stream.flush()
                os.dup2(saved_stderr, 2)
    except BaseException:
        result = 1
        raise
    finally:
        try:
            os.close(saved_stderr)
            worker.join(10)
        except BaseException:
            result = 1
            raise
        finally:
            try:
                if result == 0:
                    data.update(state='done', error='')
                else:
                    lines = ''.join(output).splitlines()
                    data['error'] = next((line.strip() for line in reversed(lines) if line.strip()), 'The update failed.')
                    kept = re.search(r'; rolled back to (\S+)$', data['error'])
                    if kept:  # The raw line can hold a whole command with its paths.
                        data['error'] = f'Tether went back to v{kept[1]}. Run tether update on the host to see why.'
                updates.write_run(data)
            finally:
                signal.signal(signal.SIGTERM, previous)
                if forward is not original and not worker.is_alive():
                    forward.close()
    return result


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] == ['update'] and '--report' in argv:
        return report_update([arg for arg in argv if arg != '--report'])
    if argv[:1] == ['item']:  # work board items: the agent command, run in this process (no server needed)
        import agent_item_cli
        return agent_item_cli.main(argv[1:])
    if argv[:1] == ['jira']:  # Jira on Done for the work board: the token is asked for, never on the command line
        import agent_jira_cli
        return agent_jira_cli.main(argv[1:])
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    update = commands.add_parser('update')
    update.add_argument('--check', action='store_true')
    update.add_argument('--yes', action='store_true')
    update.add_argument('--auto', action='store_true')
    update.add_argument('--report', action='store_true', help='Save the update result for the web UI.')
    update.add_argument('--to')
    commands.add_parser('rollback')
    for name in ('install', 'migrate'):
        command = commands.add_parser(name, help='Prepare a release' if name == 'install' else 'Move a checkout install to a release')
        command.add_argument('--to')
        command.add_argument('--archive', type=Path)
        command.add_argument('--sums', type=Path)
        if name == 'migrate':
            command.add_argument('--from', dest='source', type=Path)
    send = commands.add_parser('broadcast', help='Message many agent panes through the running Tether server.')
    send.add_argument('text')
    send.add_argument('--panes', nargs='+', help='Pane ids such as %%3 %%7 (or %%3,%%7). Default: every idle agent pane.')
    send.add_argument('--master', help='A Claude pane id: it gets the text and the target list, and delivers with its peer messaging.')
    send.add_argument('--json', action='store_true', help='Print the server reply as JSON.')
    args = parser.parse_args(argv)
    if args.command == 'broadcast':
        return broadcast(args)
    if args.command == 'install':
        install_args = [flag for key in ('to', 'archive', 'sums')
                        if getattr(args, key) is not None for flag in ('--' + key, str(getattr(args, key)))]
        return bootstrap.main(install_args)
    try:
        state_file = updates.install_file()
        if args.command == 'migrate':
            state = json.loads(state_file.read_text())
            root = Path.home() / '.local/share/tether'
            root.mkdir(parents=True, exist_ok=True)
            with (root / 'update.lock').open('a') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return migrate(args, root, state_file, state)
        state = json.loads(state_file.read_text())
        if git_checkout(state['repo']):
            print('this is a git checkout: run git pull, then python3 install.py --apply')
            return 1
        root = Path.home() / '.local/share/tether'
        releases = root / 'releases'
        link = root / 'current'
        old = link.resolve(strict=True)
        if old.parent != releases.resolve() or updates.version(old.name) != updates.version((old / 'VERSION').read_text().strip()):
            raise ValueError('Install is not a managed release')
        root.mkdir(parents=True, exist_ok=True)
        with (root / 'update.lock').open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError('Another update is in progress') from None
            if args.command == 'rollback':
                previous = json.loads((root / 'previous.json').read_text())['release']
                updates.version(previous)
                target = releases / previous
                if not target.is_dir() or target.is_symlink() or target == old:
                    raise ValueError('No previous release is available')
                activate(root, target, state_file, state)
                print('Rolled back to v' + target.name)
                return 0
            if args.auto and updates.mode() != 'auto':
                print('Automatic updates are disabled')
                return 0
            tag = None
            if args.to:
                updates.version(args.to)
                tag = 'v' + args.to.removeprefix('v')
            release = updates.fetch_release(tag)
            ver = release['tag_name'].removeprefix('v')
            if (not tag and updates.version(ver) <= updates.version(old.name)) or ver == old.name:
                print('Already up to date: v' + old.name)
                return 0
            print(f'Update available: v{ver}\n{release.get("html_url", "")}')
            if args.check:
                return 0
            if not (args.yes or args.auto) and input('Apply this release? [y/N] ').strip().lower() not in ('y', 'yes'):
                return 0
            with tempfile.TemporaryDirectory(prefix='tether-update-') as temp:
                archive, ver = release_files(release, Path(temp))
                stage = Path(temp) / 'release'
                stage.mkdir()
                extract(archive, stage)
                if stage.joinpath('VERSION').read_text().strip() != ver or not (stage / 'install.py').is_file() or not (stage / 'ui/dist/index.html').is_file():
                    raise ValueError('Invalid release contents')
                target = releases / ver
                if target.exists():
                    raise ValueError('Release directory already exists; use tether rollback for the previous release')
                partial = releases / f'.{ver}.partial'
                try:
                    shutil.copytree(stage, partial)
                    partial.rename(target)
                    activate(root, target, state_file, state)
                except Exception:
                    if partial.exists():
                        shutil.rmtree(partial)
                    if link.resolve() != target.resolve():
                        if target.exists():
                            shutil.rmtree(target)
                    raise
            print('Updated to v' + ver)
            return 0
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, EOFError, subprocess.SubprocessError, tarfile.TarError) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
